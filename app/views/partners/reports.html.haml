%h2 All Reports
%p
  The table below lists the reports that you have already created, and also any that are in-progress -- shown in bold font. The "Status" column tells you how far along the in-progress reports are. You can click the Refresh Progress button below to refresh the table for up-to-date progress. When an in-progress report is completed, the status changes, and you get a “Download” link to get the report.

%p
  - refresh_path = reports_partner_path(@partner, sort: params[:sort], direction: params[:direction])
  = button_to "Refresh Progress", refresh_path, method: :get, class: "btn btn-secondary"

%table.report-table
  %thead
    %tr
      - report_dir = (params[:sort] == 'report_type' && params[:direction] == 'asc') ? 'desc' : 'asc'
      %th= link_to "Report Type", reports_partner_path(@partner, sort: 'report_type', direction: report_dir)
      - date_dir = (params[:sort] == 'date_range' && params[:direction] == 'asc') ? 'desc' : 'asc'
      %th= link_to "Date Range", reports_partner_path(@partner, sort: 'date_range', direction: date_dir)
      - req_dir = (params[:sort] == 'requested_at' && params[:direction] == 'asc') ? 'desc' : 'asc'
      %th= link_to "Requested At", reports_partner_path(@partner, sort: 'requested_at', direction: req_dir)
      %th Status
      %th Actions
  %tbody
    - @reports.each do |r|
      - in_progress_states = [Report::Status.queued.to_s, Report::Status.building.to_s, Report::Status.merging.to_s, Report::Status.post_processing.to_s]
      - in_progress = in_progress_states.include?(r.status)
      %tr{ class: ("in-progress" if in_progress) }
        %td= r.title
        %td
          - start_str = r.start_date&.strftime('%Y-%m-%d')
          - end_str   = r.end_date&.strftime('%Y-%m-%d')
          = [start_str, end_str].compact.join(' to ')
        %td= r.created_at.strftime('%Y-%m-%d %H:%M')
        %td= r.status.humanize
        %td
          - case r.status
          - when Report::Status.queued.to_s, Report::Status.building.to_s, Report::Status.merging.to_s, Report::Status.post_processing.to_s
            = link_to "Cancel", cancel_report_partner_path(@partner, report_id: r.id), method: :delete, data: { confirm: "Really cancel this report?" }
          - when Report::Status.complete.to_s
            = link_to "Download", download_csv_partner_path(@partner, report_id: r.id)
          - when Report::Status.cancelled.to_s
            %span.text-muted Cancelled
          - else
            -# no actions for failed